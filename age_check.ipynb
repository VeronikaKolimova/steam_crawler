    "import datetime\n",
    "\n",
    "# Задаём дату рождения\n",
    "birthdate = datetime.datetime(1976, 3, 31)\n",
    "\n",
    "# Преобразуем в Unix timestamp (секунды)\n",
    "birthtime = int(birthdate.timestamp())\n",
    "\n",
    "print(birthtime)  "
